# The Flutter app reads NO runtime secrets and never loads a .env file.
# Configuration is passed at build time with --dart-define, for example:
#   flutter run --dart-define=API_BASE_URL=http://192.168.1.20:8000
#
# Supported defines:

# Base URL of the Django backend, no trailing slash.
# Default: http://127.0.0.1:8000 in debug, the Heroku URL in release.
API_BASE_URL=

# Never put API keys here. Third-party keys (RapidAPI, OMDb, OpenRouter) belong to the
# backend's .env only.
